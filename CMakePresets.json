{
  "version": 6,
  "configurePresets": [
    {
      "name": "common-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}"
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": [ "common-base" ],
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "environment": {
        "VK_ADD_LAYER_PATH": "${sourceDir}/out/build/${presetName}/vcpkg_installed/x64-windows/bin"
      },
      "cacheVariables": {
        "VKE_COMPILE_VULKAN_RHI": "ON",
        "VKE_COMPILE_D3D12_RHI": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": [ "common-base" ],
      "cacheVariables": {
        "VKE_COMPILE_VULKAN_RHI": "ON",
        "VKE_COMPILE_D3D12_RHI": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "msvc-env",
      "hidden": true,
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "inheritedEnvironments": [ "msvc_x64_x64" ]
        }
      }
    },
    {
      "name": "msvc-d3d12",
      "hidden": true,
      "inherits": [ "msvc-env" ],
      "cacheVariables": {
        "VKE_RENDER_SYSTEM": "2",
        "CMAKE_C_FLAGS": "/DVKE_RENDER_SYSTEM=VKE_D3D12",
        "CMAKE_CXX_FLAGS": "/DVKE_RENDER_SYSTEM=VKE_D3D12"
      }
    },
    {
      "name": "msvc-vulkan",
      "hidden": true,
      "inherits": [ "msvc-env" ],
      "cacheVariables": {
        "VKE_RENDER_SYSTEM": "1",
        "CMAKE_C_FLAGS": "/DVKE_RENDER_SYSTEM=VKE_VULKAN",
        "CMAKE_CXX_FLAGS": "/DVKE_RENDER_SYSTEM=VKE_VULKAN"
      }
    },
    {
      "name": "gcc-d3d12",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VKE_RENDER_SYSTEM": "2",
        "CMAKE_C_FLAGS": "-DVKE_RENDER_SYSTEM=VKE_D3D12",
        "CMAKE_CXX_FLAGS": "-DVKE_RENDER_SYSTEM=VKE_D3D12"
      }
    },
    {
      "name": "gcc-vulkan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VKE_RENDER_SYSTEM": "1",
        "CMAKE_C_FLAGS": "-DVKE_RENDER_SYSTEM=VKE_VULKAN",
        "CMAKE_CXX_FLAGS": "-DVKE_RENDER_SYSTEM=VKE_VULKAN"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_DEBUG_POSTFIX": "_d"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Windows-MSVC-D3D12-x64-Debug",
      "inherits": [ "msvc-d3d12", "debug", "windows-base" ]
    },
    {
      "name": "Windows-MSVC-D3D12-x64-Release",
      "inherits": [ "msvc-d3d12", "release", "windows-base" ]
    },
    {
      "name": "Windows-MSVC-Vulkan-x64-Debug",
      "inherits": [ "msvc-vulkan", "debug", "windows-base" ]
    },
    {
      "name": "Windows-MSVC-Vulkan-x64-Release",
      "inherits": [ "msvc-vulkan", "release", "windows-base" ]
    },
    {
      "name": "Windows-MinGW-D3D12-x64-Debug",
      "inherits": [ "gcc-d3d12", "debug", "windows-base" ]
    },
    {
      "name": "Windows-MinGW-D3D12-x64-Release",
      "inherits": [ "gcc-d3d12", "release", "windows-base" ]
    },
    {
      "name": "Windows-MinGW-Vulkan-x64-Debug",
      "inherits": [ "gcc-vulkan", "debug", "windows-base" ]
    },
    {
      "name": "Windows-MinGW-Vulkan-x64-Release",
      "inherits": [ "gcc-vulkan", "release", "windows-base" ]
    },
    {
      "name": "Linux-GCC-Vulkan-x64-Debug",
      "inherits": [ "gcc-vulkan", "debug", "linux-base" ]
    },
    {
      "name": "Linux-GCC-Vulkan-x64-Release",
      "inherits": [ "gcc-vulkan", "release", "linux-base" ]
    }
  ],
  "buildPresets": [
    {
      "name": "Windows-MSVC-D3D12-x64-Debug",
      "configurePreset": "Windows-MSVC-D3D12-x64-Debug"
    },
    {
      "name": "Windows-MSVC-D3D12-x64-Release",
      "configurePreset": "Windows-MSVC-D3D12-x64-Release"
    },
    {
      "name": "Windows-MSVC-Vulkan-x64-Debug",
      "configurePreset": "Windows-MSVC-Vulkan-x64-Debug"
    },
    {
      "name": "Windows-MSVC-Vulkan-x64-Release",
      "configurePreset": "Windows-MSVC-Vulkan-x64-Release"
    },
    {
      "name": "Windows-MinGW-D3D12-x64-Debug",
      "configurePreset": "Windows-MinGW-D3D12-x64-Debug",
      "nativeToolOptions": [ "-k1" ]
    },
    {
      "name": "Windows-MinGW-D3D12-x64-Release",
      "configurePreset": "Windows-MinGW-D3D12-x64-Release",
      "nativeToolOptions": [ "-k1" ]
    },
    {
      "name": "Windows-MinGW-Vulkan-x64-Debug",
      "configurePreset": "Windows-MinGW-Vulkan-x64-Debug",
      "nativeToolOptions": [ "-k1" ]
    },
    {
      "name": "Windows-MinGW-Vulkan-x64-Release",
      "configurePreset": "Windows-MinGW-Vulkan-x64-Release",
      "nativeToolOptions": [ "-k1" ]
    },
    {
      "name": "Linux-GCC-Vulkan-x64-Debug",
      "configurePreset": "Linux-GCC-Vulkan-x64-Debug",
      "nativeToolOptions": [ "-k1" ]
    },
    {
      "name": "Linux-GCC-Vulkan-x64-Release",
      "configurePreset": "Linux-GCC-Vulkan-x64-Release",
      "nativeToolOptions": [ "-k1" ]
    }
  ]
}
