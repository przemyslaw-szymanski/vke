{
  "version": 6,
  "configurePresets": [
    {
      "name": "common-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_DEBUG_POSTFIX": "_d",
        "VKE_DATA_DIR": "${sourceDir}/bin"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": [
        "common-base"
      ],
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "environment": {
        "VK_ADD_LAYER_PATH": "${sourceDir}/out/build/${presetName}/vcpkg_installed/x64-windows/bin"
      },
      "cacheVariables": {
        "VKE_COMPILE_VULKAN_RHI": "ON",
        "VKE_COMPILE_D3D12_RHI": "ON",
        "VKE_RENDER_SYSTEM": "D3D12"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": [
        "common-base"
      ],
      "cacheVariables": {
        "VKE_COMPILE_VULKAN_RHI": "ON",
        "VKE_COMPILE_D3D12_RHI": "OFF",
        "VKE_RENDER_SYSTEM": "Vulkan"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "mingw-base",
      "hidden": true,
      "inherits": [
        "windows-base"
      ],
      "environment": {
        "VK_ADD_LAYER_PATH": "${sourceDir}/out/build/${presetName}/vcpkg_installed/x64-mingw-dynamic/bin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic",
        "VCPKG_HOST_TRIPLET": "x64-mingw-dynamic"
      }
    },
    {
      "name": "vs-generator",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "msvc-env",
      "hidden": true,
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "inheritedEnvironments": [
            "msvc_x64_x64"
          ]
        }
      }
    },
    {
      "name": "msvc",
      "hidden": true,
      "inherits": [
        "msvc-env"
      ]
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "inherits": [
        "msvc-env"
      ],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "clang-vs",
      "hidden": true,
      "inherits": [
        "msvc-env"
      ],
      "toolset": {
        "value": "ClangCL",
        "strategy": "set"
      }
    },
    {
      "name": "clang-linux",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "Windows-Ninja-MSVC-x64",
      "inherits": [
        "msvc",
        "windows-base"
      ]
    },
    {
      "name": "Windows-VisualStudio-MSVC-x64",
      "inherits": [
        "vs-generator",
        "msvc",
        "windows-base"
      ]
    },
    {
      "name": "Windows-Ninja-Clang-x64",
      "inherits": [
        "clang",
        "windows-base"
      ]
    },
    {
      "name": "Windows-VisualStudio-Clang-x64",
      "inherits": [
        "vs-generator",
        "clang-vs",
        "windows-base"
      ]
    },
    {
      "name": "Windows-Ninja-MinGW-x64",
      "inherits": [
        "gcc",
        "mingw-base"
      ]
    },
    {
      "name": "Linux-Ninja-GCC-x64",
      "inherits": [
        "gcc",
        "linux-base"
      ]
    },
    {
      "name": "Linux-Ninja-Clang-x64",
      "inherits": [
        "clang-linux",
        "linux-base"
      ]
    }
  ],
  "buildPresets": [
