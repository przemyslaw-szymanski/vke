{
  "version": 6,
  "configurePresets": [
    {
      "name": "common-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "VKE_DATA_DIR": "${sourceDir}/bin"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": [
        "common-base"
      ],
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "environment": {
        "VK_ADD_LAYER_PATH": "${sourceDir}/out/build/${presetName}/vcpkg_installed/x64-windows/bin"
      },
      "cacheVariables": {
        "VKE_COMPILE_VULKAN_RHI": "ON",
        "VKE_COMPILE_D3D12_RHI": "ON",
        "VKE_RENDER_SYSTEM": "D3D12"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": [
        "common-base"
      ],
      "cacheVariables": {
        "VKE_COMPILE_VULKAN_RHI": "ON",
        "VKE_COMPILE_D3D12_RHI": "OFF",
        "VKE_RENDER_SYSTEM": "Vulkan"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "mingw-base",
      "hidden": true,
      "inherits": [
        "windows-base"
      ],
      "environment": {
        "VK_ADD_LAYER_PATH": "${sourceDir}/out/build/${presetName}/vcpkg_installed/x64-mingw-dynamic/bin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic",
        "VCPKG_HOST_TRIPLET": "x64-mingw-dynamic"
      }
    },
    {
      "name": "msvc-env",
      "hidden": true,
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "inheritedEnvironments": [
            "msvc_x64_x64"
          ]
        }
      }
    },
    {
      "name": "msvc",
      "hidden": true,
      "inherits": [
        "msvc-env"
      ]
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "inherits": [
        "msvc-env"
      ],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "clang-linux",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_DEBUG_POSTFIX": "_d"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Windows-MSVC-x64-Debug",
      "inherits": [
        "msvc",
        "debug",
        "windows-base"
      ]
    },
    {
      "name": "Windows-MSVC-x64-Release",
      "inherits": [
        "msvc",
        "release",
        "windows-base"
      ]
    },
    {
      "name": "Windows-MinGW-x64-Debug",
      "inherits": [
        "gcc",
        "debug",
        "mingw-base"
      ]
    },
    {
      "name": "Windows-MinGW-x64-Release",
      "inherits": [
        "gcc",
        "release",
        "mingw-base"
      ]
    },
    {
      "name": "Windows-Clang-x64-Debug",
      "inherits": [
        "clang",
        "debug",
        "windows-base"
      ]
    },
    {
      "name": "Windows-Clang-x64-Release",
      "inherits": [
        "clang",
        "release",
        "windows-base"
      ]
    },
    {
      "name": "Linux-GCC-x64-Debug",
      "inherits": [
        "gcc",
        "debug",
        "linux-base"
      ]
    },
    {
      "name": "Linux-GCC-x64-Release",
      "inherits": [
        "gcc",
        "release",
        "linux-base"
      ]
    },
    {
      "name": "Linux-Clang-x64-Debug",
      "inherits": [
        "clang-linux",
        "debug",
        "linux-base"
      ]
    },
    {
      "name": "Linux-Clang-x64-Release",
      "inherits": [
        "clang-linux",
        "release",
        "linux-base"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "Windows-MSVC-x64-Debug",
      "configurePreset": "Windows-MSVC-x64-Debug"
    },
    {
      "name": "Windows-MSVC-x64-Release",
      "configurePreset": "Windows-MSVC-x64-Release"
    },
    {
      "name": "Windows-MinGW-x64-Debug",
      "configurePreset": "Windows-MinGW-x64-Debug",
      "nativeToolOptions": [
        "-k1"
      ]
    },
    {
      "name": "Windows-MinGW-x64-Release",
      "configurePreset": "Windows-MinGW-x64-Release",
      "nativeToolOptions": [
        "-k1"
      ]
    },
    {
      "name": "Windows-Clang-x64-Debug",
      "configurePreset": "Windows-Clang-x64-Debug"
    },
    {
      "name": "Windows-Clang-x64-Release",
      "configurePreset": "Windows-Clang-x64-Release"
    },
    {
      "name": "Linux-GCC-x64-Debug",
      "configurePreset": "Linux-GCC-x64-Debug",
      "nativeToolOptions": [
        "-k1"
      ]
    },
    {
      "name": "Linux-GCC-x64-Release",
      "configurePreset": "Linux-GCC-x64-Release",
      "nativeToolOptions": [
        "-k1"
      ]
    },
    {
      "name": "Linux-Clang-x64-Debug",
      "configurePreset": "Linux-Clang-x64-Debug",
      "nativeToolOptions": [
        "-k1"
      ]
    },
    {
      "name": "Linux-Clang-x64-Release",
      "configurePreset": "Linux-Clang-x64-Release",
      "nativeToolOptions": [
        "-k1"
      ]
    }
  ]
}
